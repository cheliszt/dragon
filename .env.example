# Obtain this token from https://aistudio.baidu.com/account/accessToken
PADDLEOCR_ACCESS_TOKEN=

# Obtain an API key from the OpenAI platform.
OPENAI_API_KEY=

# OpenAI-compatible API base URL. The application appends /responses.
OPENAI_BASE_URL=https://api.openai.com/v1

# Set this to a model available from the configured API provider.
OPENAI_MODEL=gpt-5.4
